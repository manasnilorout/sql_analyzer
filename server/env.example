# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Google AI Configuration (for Genkit and Google Generic LLM SDK)
GOOGLE_GENAI_API_KEY=your_google_ai_api_key_here
# Optional: Override default Google Generic LLM model settings (used by LlmFactory with 'google-generic' type)
# GOOGLE_GENAI_DEFAULT_MODEL="gemini-1.5-flash-latest"
# GOOGLE_GENAI_DEFAULT_TEMPERATURE="0.7"
# GOOGLE_GENAI_DEFAULT_MAX_TOKENS="2048"

# OpenAI Configuration (for custom LlmFactory)
OPENAI_API_KEY="" # Add your OpenAI API key here if using OpenAI models directly
# Optional: Override default OpenAI model settings
# OPENAI_DEFAULT_MODEL="gpt-4o"
# OPENAI_DEFAULT_TEMPERATURE="0.7"
# OPENAI_DEFAULT_MAX_TOKENS="2048"

# Google Vertex AI Configuration
# GOOGLE_APPLICATION_CREDENTIALS="" # Path to your service account key file (optional, ADC usually preferred)
VERTEXAI_PROJECT_ID="" # Your Google Cloud Project ID
VERTEXAI_LOCATION="us-central1" # e.g., us-central1, us-east1
VERTEXAI_DEFAULT_MODEL="gemini-1.5-flash-001" # Specify desired Vertex AI Gemini model
# Optional: Override default Vertex AI model settings
# VERTEXAI_DEFAULT_TEMPERATURE="0.7"
# VERTEXAI_DEFAULT_MAX_TOKENS="2048"

# Global LLM API Timeout
LLM_API_TIMEOUT_MS="120000" # Timeout for LLM API calls in milliseconds (e.g., 120000 for 2 minutes)

# Database Configuration (if needed in the future)
# DATABASE_URL=your_database_url_here

# Security (for production)
# JWT_SECRET=your_jwt_secret_here
# CORS_ORIGIN=https://yourdomain.com 